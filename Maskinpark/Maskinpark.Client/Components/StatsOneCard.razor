@*============================================================================*
 * COMPONENT: STATS ONE CARD                                                  *
 *                                                                            *
 * File: Maskinpark/Maskinpark.Client/Components/StatsOneCard.razor           *
 *                                                                            *
 * Card for displaying a single statistic.                                    *
 * The component is used in the parent StatsCards.                            *
 *============================================================================*@

@* --- Local Styles CSS --- *@
<style>
    .stats-card {
        margin: 0px;
        padding: 0px;
        border-color: #E3E3E8;
    }
    .stats-card-body {
        display: flex;
        margin: 0px;
        padding: 12px 5px 5px 12px;
        height: auto;
        font-size: 15px;
        font-weight: bold;
        background-color: #F2F3F7;
    }
    .stats-card-body-title {
        padding: 0 0 0 12px;
    }
    .stats-card-body-subtitle {
        font-size: 18px;
    }
    .stats-card-body img {
        width: 47px;
        min-width: 42px;
        height: 47px;
        min-height: 34px;
        margin-top: 0px;
        padding: 5px;
        background-color: #E3E3E8; /* F2F3F7 E6E6E8 E3E3E8 DBDBDB */
        border: none;
    }
</style>

<div class="col">
    <div class="card stats-card">
        <div class="card-body stats-card-body">
            <img src="@ImageUrl" alt="@AltText" class="card" />
            <div class="stats-card-body-title">
                @Title
                <div class="stats-card-body-subtitle">@SubTitle</div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public string ImageUrl { get; set; } = null!;
    [Parameter] public string AltText { get; set; } = null!;
    [Parameter] public string Title { get; set; } = null!;
    [Parameter] public string SubTitle { get; set; } = null!;
}
