@*============================================================================*
 * COMPONENT: CHART CARD                                                      *
 *                                                                            *
 * File: Maskinpark/Maskinpark.Client/Components/ChartCard.razor              *
 *                                                                            *
 * Card for displaying a chart.                                               *
 * The component is used in the parent MainCards.                             *
 *============================================================================*@

@* --- Local Styles CSS --- *@
<style>
    .chart-card-title {
        font-weight: bold;
        font-size: 18px;
        margin-bottom: 15px;
    }
    .chart-container {
        width: 100%;
        height: 100%;
    }
    .chart-spinner-wrapper {
        position: absolute;
        inset: 0; /* top:0; right:0; bottom:0; left:0; */
        display: flex; 
        justify-content: center;
        align-items: center;
        background: rgba(255,255,255,0.0); /* transparent overlay */
    }
    .chart-spinner {
        width: 75px;
        height: 75px;
        font-size: 60px;
    }
</style>

@* --- JavaScript --- *@
<script>
    function startSpinner() {
        var wrapper = document.getElementById("spinnerWrapper");
        if (wrapper) wrapper.style.display = 'flex';
    }
    function stopSpinner() {
        var wrapper = document.getElementById("spinnerWrapper");
        if (wrapper) wrapper.style.display = 'none';
    }

    // *** Function to render the chart using Chart.js *** //
    function renderChart(chartId, data, labels) {
        const ctx = document.getElementById(chartId).getContext('2d');
        new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Daily Stats',
                    data: data,
                    borderColor: 'rgba(75, 192, 192, 1)',
                    backgroundColor: 'rgba(75, 192, 192, 0.2)',
                    fill: true,
                    tension: 0.4
                }]
            },
            options: {
                responsive: true,
                plugins: {legend: {display: false}},
                scales: {
                    x: {title: {display: true, text: 'Days of the Week'}},
                    y: {title: {display: true, text: 'Values'}, beginAtZero: true}
                }
            }
        });
    }
</script>

@* --- HTML --- *@
<h5 class="card-title chart-card-title">Daily Stats</h5>

<div class="chart-spinner-wrapper" id="spinnerWrapper">
    <div id="spinner" class="spinner-border text-primary chart-spinner" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
</div>

<div class="chart-container">
    <canvas id="dailyChart"></canvas>
</div>

@* --- C# Code --- *@
@code {
    [Inject] IJSRuntime JS { get; set; } = null!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Start Spinner
            await JS.InvokeVoidAsync("startSpinner");

            // Show the chart after rendering the component for the first time
            await JS.InvokeVoidAsync("renderChart", "dailyChart",
                // new[] { 10, 12, 14, 13, 15, 14, 16, 15 },
                new[] { 6, 12, 4, 11, 8, 6, 14, 16 },
                new[] { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" });

            // Stop Spinner
            await JS.InvokeVoidAsync("stopSpinner");
        }
    }
}
