@*============================================================================*
 * COMPONENT: CHART CARD                                                      *
 *                                                                            *
 * File: Maskinpark/Maskinpark.Client/Components/ChartCard.razor              *
 *                                                                            *
 * Card for displaying a chart.                                               *
 * The component is used in the parent MainCards.                             *
 *============================================================================*@

@* --- Local Styles CSS --- *@
<style> 
    .chart-card {
        position: relative; 
        height: 200px;
    }
    .chart-card-title {
        font-weight: bold;
        font-size: 18px;
        margin-bottom: 15px;
    }
    .chart-container {
        width: 100%;
        height: 100%;
    }
    .chart-spinner-wrapper {
        align: center;
        align-items: center;
        left: 50%;
        width: 100%;
        /* 
        top: 100px;
        vertical-align: middle;
        center: center;
        visibility: hidden;
        position: absolute; 
        top: 50%;
        left: 50%;

        */
    }
</style>

<script>
    function startSpinner() {
        document.getElementById("spinner").style.visibility = 'visible';
        document.getElementById("spinner").style.animationIterationCount = 'Infinite';
    }
    function stopSpinner() {
        document.getElementById("spinner").style.visibility = 'hidden';
        document.getElementById("spinner").style.animationIterationCount = 0;
    }

    // *** Function to render the chart using Chart.js *** //
    function renderChartNew(chartId, data, labels) {
        const ctx = document.getElementById(chartId).getContext('2d');
        new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Daily Stats',
                    data: data,
                    borderColor: 'rgba(75, 192, 192, 1)',
                    backgroundColor: 'rgba(75, 192, 192, 0.2)',
                    fill: true,
                    tension: 0.4
                }]
            },
            options: {
                responsive: true,
                plugins: {legend: {display: false}},
                scales: {
                    x: {title: {display: true, text: 'Days of the Week'}},
                    y: {title: {display: true, text: 'Values'}, beginAtZero: true}
                }
            }
        });
    }
</script>

<h5 class="card-title chart-card-title">Daily Stats</h5>

<div class="chart-spinner-wrapper">
    <div id="spinner" class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
</div>

<div class="chart-container">
    <canvas id="dailyChart"></canvas>
</div>


@code {
    [Inject] IJSRuntime JS { get; set; } = null!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Start Spinner
            await JS.InvokeVoidAsync("startSpinner");

            // Show the chart after rendering the component for the first time
            await JS.InvokeVoidAsync("renderChartNew", "dailyChart",
                new[] { 10, 12, 14, 13, 15, 14, 16, 15 },
                new[] { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" });

            // Stop Spinner
            await JS.InvokeVoidAsync("stopSpinner");
        }
    }


