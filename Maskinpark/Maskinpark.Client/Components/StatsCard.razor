    <div class="col">
        <div class="card stats-card">
            <div class="card-body stats-card-body">
                <p class="card-text">Machines Offline</p>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card stats-card">
            <div class="card-body stats-card-body">
                <p class="card-text">Last Updated</p>
            </div>
        </div>
    </div>
